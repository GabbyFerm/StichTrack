<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:StitchTrack.Application.ViewModels;assembly=StitchTrack.Application"
             xmlns:entities="clr-namespace:StitchTrack.Domain.Entities;assembly=StitchTrack.Domain"
             x:Class="StitchTrack.MAUI.Views.SingleProjectPage"
             x:DataType="viewModels:SingleProjectViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
             Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="Auto,*">

    <!-- TOP BAR: Logo -->
    <Grid Grid.Row="0"
      BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
      Padding="30,30">
      <Image Source="logo.svg"
         HeightRequest="35"
         HorizontalOptions="Start"
         Aspect="AspectFit" />
    </Grid>

    <!-- SCROLLABLE CONTENT  -->
    <ScrollView Grid.Row="1">

      <VerticalStackLayout Spacing="0">

        <!-- PROJECT IMAGE — full width, no card -->
        <Grid HeightRequest="220">

          <Image Source="{Binding ImageUrl}"
                 Aspect="AspectFill" />

          <!-- Gradient overlay -->
          <BoxView VerticalOptions="End"
                   HeightRequest="60">
            <BoxView.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="Transparent" Offset="0.0" />
                <GradientStop Color="#90000000" Offset="1.0" />
              </LinearGradientBrush>
            </BoxView.Background>
          </BoxView>

          <Label Text="← Swipe to go back to projects"
                 FontFamily="MontserratMedium"
                 FontSize="11"
                 FontAttributes="Italic"
                 TextColor="White"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="16,0,16,10"
                 Opacity="0.85" />

        </Grid>

        <!-- PROJECT HEADER: Name + Color dot + Divider  -->
        <VerticalStackLayout Padding="20,16,20,0" Spacing="8">

          <HorizontalStackLayout Spacing="10" VerticalOptions="Center">

            <!-- Color dot -->
            <Border WidthRequest="14"
                    HeightRequest="14"
                    StrokeThickness="0"
                    BackgroundColor="{Binding ColorHex}"
                    VerticalOptions="Center"
                    IsVisible="{Binding ColorHex, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="7" />
              </Border.StrokeShape>
            </Border>

            <Label Text="{Binding ProjectName}"
                   FontFamily="MontserratBold"
                   FontSize="20"
                   TextTransform="Uppercase"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                   VerticalOptions="Center" />

          </HorizontalStackLayout>

          <!-- Gold divider below project name -->
          <BoxView HeightRequest="1"
                   BackgroundColor="{StaticResource BrandGold}"
                   HorizontalOptions="Fill"
                   Opacity="0.4" />

        </VerticalStackLayout>

        <!-- TAGS + NEEDLE SIZE — only shown when set -->
        <VerticalStackLayout Padding="20,12,20,0"
                     Spacing="6"
                     IsVisible="{Binding HasTags}">

          <!-- Tag chips — built from the Tags collection -->
          <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                      Wrap="Wrap"
                      Direction="Row">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="entities:ProjectTag">
                <Border StrokeThickness="0"
                        Padding="10,4"
                        Margin="0,0,6,6">
                  <Border.BackgroundColor>
                    <Binding Path="ColorIndex"
                            Converter="{StaticResource TagColorIndexConverter}" />
                  </Border.BackgroundColor>
                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                  </Border.StrokeShape>
                  <Label Text="{Binding Name}"
                         FontFamily="MontserratMedium"
                         FontSize="11"
                         TextColor="White" />
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>

        </VerticalStackLayout>

        <!-- PROGRESS ROW + CONTINUE COUNTING BUTTON -->
        <VerticalStackLayout Padding="20,16,20,0" Spacing="16">

          <!-- Combined details row: needle size · row count · progress -->
          <HorizontalStackLayout Spacing="6">

            <!-- Needle icon — only shown if size is set -->
            <Image WidthRequest="14"
                   HeightRequest="14"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNeedleOrHookSize}">
              <Image.Source>
                <AppThemeBinding Light="needle_light.svg" Dark="needle_dark.svg" />
              </Image.Source>
            </Image>

            <!-- Needle size text -->
            <Label Text="{Binding NeedleOrHookSize}"
                   FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNeedleOrHookSize}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}" />

            <!-- Separator — only shown if needle size is set -->
            <Label Text="|"
                   FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNeedleOrHookSize}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}" />

            <!-- Row count — always shown -->
            <Label FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}">
              <Label.Text>
                <MultiBinding StringFormat="Row {0}{1}">
                  <Binding Path="CurrentCount" />
                  <Binding Path="TotalRows"
                         Converter="{StaticResource TotalRowsConverter}" />
                </MultiBinding>
              </Label.Text>
            </Label>

            <!-- Separator — only shown if total rows is set -->
            <Label Text="|"
                   FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   IsVisible="{Binding TotalRows,
                               Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}" />

            <!-- Progress percentage — only shown if total rows is set -->
            <Label Text="{Binding ProgressPercentage}"
                   FontFamily="MontserratSemiBold"
                   FontSize="14"
                   VerticalOptions="Center"
                   IsVisible="{Binding TotalRows,
                               Converter={StaticResource IsNotNullConverter}}"
                   TextColor="{StaticResource BrandGold}" />

          </HorizontalStackLayout>

          <!-- Session summary — only shown if project has sessions -->
          <HorizontalStackLayout Spacing="6"
                                  IsVisible="{Binding HasSessions}">

            <Image WidthRequest="14"
                   HeightRequest="14"
                   VerticalOptions="Center">
              <Image.Source>
                <AppThemeBinding Light="timer_light.svg" Dark="timer_dark.svg" />
              </Image.Source>
            </Image>

            <!-- "Last: Tuesday" -->
            <Label FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}">
              <Label.Text>
                <MultiBinding StringFormat="Last session: {0}">
                  <Binding Path="LastSessionText" />
                </MultiBinding>
              </Label.Text>
            </Label>

            <Label Text="|"
                   FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}" />

            <!-- "Total: 3h 20m" -->
            <Label FontFamily="MontserratMedium"
                   FontSize="14"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}">
              <Label.Text>
                <MultiBinding StringFormat="Total time: {0}">
                  <Binding Path="TotalTimeText" />
                </MultiBinding>
              </Label.Text>
            </Label>

          </HorizontalStackLayout>

          <!-- Continue Counting Button with chevron icon -->
          <Border StrokeThickness="0"
                  BackgroundColor="{StaticResource BrandGold}"
                  HeightRequest="52">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ContinueCountingCommand}" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
              <Label Text="CONTINUE COUNTING"
                     FontFamily="MontserratBold"
                     FontSize="14"
                     TextColor="White"
                     VerticalOptions="Center" />
              <Image Source="chevron_right.svg"
                     WidthRequest="18"
                     HeightRequest="18"
                     VerticalOptions="Center">
                <Image.Behaviors>
                  <toolkit:IconTintColorBehavior TintColor="White" />
                </Image.Behaviors>
              </Image>
            </HorizontalStackLayout>
          </Border>

        </VerticalStackLayout>

        <!-- PATTERN FILES -->
        <VerticalStackLayout Padding="20,20,20,0"
                     Spacing="8"
                     IsVisible="{Binding HasPatternFiles}">
          <HorizontalStackLayout Spacing="8">
            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
              <Image.Source>
                <AppThemeBinding Light="file_light.svg" Dark="file_dark.svg" />
              </Image.Source>
            </Image>
            <Label Text="Pattern"
                   FontFamily="MontserratSemiBold" FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                               Dark={StaticResource DarkTextPrimary}}" />
          </HorizontalStackLayout>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandGold}"
             HorizontalOptions="Fill" Opacity="0.4" />
          <!-- 2-column grid built in code-behind -->
          <VerticalStackLayout x:Name="PatternFilesGrid" Spacing="8" />
        </VerticalStackLayout>

        <!-- INSPIRATION PHOTOS -->
        <VerticalStackLayout Padding="20,20,20,0"
                             Spacing="8"
                             IsVisible="{Binding HasInspirationPhotos}">
          <HorizontalStackLayout Spacing="8">
            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
              <Image.Source>
                <AppThemeBinding Light="photo_light.svg" Dark="photo_dark.svg" />
              </Image.Source>
            </Image>
            <Label Text="Inspiration"
                   FontFamily="MontserratSemiBold" FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                               Dark={StaticResource DarkTextPrimary}}" />
          </HorizontalStackLayout>
          <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandGold}"
                  HorizontalOptions="Fill" Opacity="0.4" />
          <!-- 2-column grid built in code-behind -->
          <VerticalStackLayout x:Name="InspirationPhotosGrid" Spacing="8" />
        </VerticalStackLayout>

        <!-- ============================================ -->
        <!-- NOTES SECTION — flat, no card                -->
        <!-- ============================================ -->
        <VerticalStackLayout Padding="20,20,20,0"
                             Spacing="8"
                             IsVisible="{Binding HasNotes}">

          <HorizontalStackLayout Spacing="8">
            <Image Grid.Column="0"
                   WidthRequest="16"
                   HeightRequest="16"
                   VerticalOptions="Center">
              <Image.Source>
                <AppThemeBinding Light="notes_light.svg" Dark="notes_dark.svg" />
              </Image.Source>
            </Image>
            <Label Text="Notes"
                   FontFamily="MontserratSemiBold"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
          </HorizontalStackLayout>

          <!-- Gold divider -->
          <BoxView HeightRequest="1"
                   BackgroundColor="{StaticResource BrandGold}"
                   HorizontalOptions="Fill"
                   Opacity="0.4" />

          <Label Text="{Binding Notes}"
                 FontFamily="MontserratRegular"
                 FontSize="14"
                 LineBreakMode="WordWrap"
                 MaxLines="{Binding NotesMaxLines}"
                 TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

          <Label Text="{Binding NotesToggleText}"
                 FontFamily="MontserratMedium"
                 FontSize="14"
                 TextColor="{StaticResource BrandGold}"
                 IsVisible="{Binding NotesCanExpand}">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ToggleNotesCommand}" />
            </Label.GestureRecognizers>
          </Label>

        </VerticalStackLayout>

        <!-- ACTION BUTTONS: Edit | Archive/Unarchive | Delete -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="10"
              Margin="20,24,20,32">

          <!-- Edit Button -->
          <Border Grid.Column="0"
                  Padding="12,10"
                  StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondary}, Dark={StaticResource ButtonSecondaryDark}}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding EditProjectCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
              <Image Source="edit.svg"
                     WidthRequest="16"
                     HeightRequest="16"
                     VerticalOptions="Center">
                <Image.Behaviors>
                  <toolkit:IconTintColorBehavior TintColor="White" />
                </Image.Behaviors>
              </Image>
              <Label Text="Edit"
                     FontFamily="MontserratMedium"
                     FontSize="14"
                     TextColor="White"
                     VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>

          <!-- Archive / Unarchive Button -->
          <Border Grid.Column="1"
                  Padding="12,10"
                  StrokeThickness="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondary}, Dark={StaticResource ButtonSecondaryDark}}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ArchiveProjectCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
              <Image Source="archive.svg"
                     WidthRequest="16"
                     HeightRequest="16"
                     VerticalOptions="Center">
                <Image.Behaviors>
                  <toolkit:IconTintColorBehavior TintColor="White" />
                </Image.Behaviors>
              </Image>
              <Label Text="{Binding ArchiveButtonText}"
                     FontFamily="MontserratMedium"
                     FontSize="14"
                     TextColor="White"
                     VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>

          <!-- Delete Button -->
          <Border Grid.Column="2"
                  Padding="12,10"
                  StrokeThickness="0"
                  BackgroundColor="{StaticResource ButtonCancel}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding DeleteProjectCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
              <Image Source="trash.svg"
                     WidthRequest="16"
                     HeightRequest="16"
                     VerticalOptions="Center">
                <Image.Behaviors>
                  <toolkit:IconTintColorBehavior TintColor="White" />
                </Image.Behaviors>
              </Image>
              <Label Text="Delete"
                     FontFamily="MontserratMedium"
                     FontSize="14"
                     TextColor="White"
                     VerticalOptions="Center" />
            </HorizontalStackLayout>
          </Border>

        </Grid>

      </VerticalStackLayout>

    </ScrollView>

  </Grid>

</ContentPage>
