<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:StitchTrack.Application.ViewModels;assembly=StitchTrack.Application"
             x:Class="StitchTrack.MAUI.Views.ProjectCounterPage"
             x:DataType="viewModels:ProjectCounterViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
             Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- TOP BAR -->
    <Grid Grid.Row="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
          Padding="30,30,30,30">
      <Image Source="logo.svg"
             HeightRequest="35"
             HorizontalOptions="Start"
             Aspect="AspectFit" />
    </Grid>

    <!-- PROJECT NAME + Project color dot-->
    <Grid Grid.Row="1"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
          Padding="30,10,20,16">
      <HorizontalStackLayout Spacing="10"
                             HorizontalOptions="Start"
                             VerticalOptions="Center">
        <Border WidthRequest="20"
                HeightRequest="20"
                StrokeThickness="1"
                Stroke="White"
                BackgroundColor="{Binding ColorHex}"
                VerticalOptions="Center">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
        </Border>
        <Label Text="{Binding ProjectName}"
               Style="{StaticResource HeaderTitle}"
               TextTransform="Uppercase"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
    </Grid>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView Grid.Row="2">
      <VerticalStackLayout Spacing="0" Padding="16">

        <!-- SESSION CARD -->
        <Border Padding="16,14"
                Margin="0,8,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground},
                                                  Dark={StaticResource DarkCardBackground}}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
          </Border.StrokeShape>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Grid.Column="0"
                   Text="{Binding SessionTimerText}"
                   Style="{StaticResource FontBold}"
                   FontSize="22"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                               Dark={StaticResource DarkTextPrimary}}" />
            <Border Grid.Column="1"
                    Padding="16,10"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondary},
                                                      Dark={StaticResource ButtonSecondaryDark}}"
                    VerticalOptions="Center">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
              </Border.StrokeShape>
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleSessionCommand}" />
              </Border.GestureRecognizers>
              <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="{Binding SessionButtonIcon}"
                       WidthRequest="16"
                       HeightRequest="16"
                       VerticalOptions="Center">
                  <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                  </Image.Behaviors>
                </Image>
                <Label Text="{Binding SessionButtonText}"
                       Style="{StaticResource FontSemiBold}"
                       FontSize="13"
                       TextColor="White"
                       VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Border>
          </Grid>
        </Border>

        <!-- PATTERN FILES — accent bar + inline file links built in code-behind -->
        <Grid IsVisible="{Binding HasPattern}"
              Margin="10,15,0,0"
              ColumnDefinitions="3,*"
              ColumnSpacing="10">
          <BoxView Grid.Column="0"
                   BackgroundColor="{StaticResource BrandGold}"
                   VerticalOptions="Fill"
                   CornerRadius="2" />
          <FlexLayout x:Name="CounterPatternFilesGrid"
                      Grid.Column="1"
                      Wrap="Wrap"
                      Direction="Row"
                      AlignItems="Center">
            <Image WidthRequest="16"
                   HeightRequest="16"
                   VerticalOptions="Center"
                   Margin="0,0,3,0">
              <Image.Source>
                <AppThemeBinding Light="file_light.svg" Dark="file_dark.svg" />
              </Image.Source>
            </Image>
            <Label Text="Pattern:"
                   Style="{StaticResource FontSemiBold}"
                   FontSize="13"
                   Margin="2,0,5,0"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}" />
            <!-- File links added by BuildCounterPatternFilesRow() -->
          </FlexLayout>
        </Grid>

        <!-- PROGRESS BAR — only shown when TotalRows is set, driven by primary counter -->
        <VerticalStackLayout Spacing="6"
                             IsVisible="{Binding HasTotalRows}"
                             Margin="0,16,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding ProgressText}"
                   Style="{StaticResource FontMedium}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            <Label Grid.Column="1"
                   Text="{Binding ProgressPercentage}"
                   Style="{StaticResource FontSemiBold}"
                   FontSize="13"
                   TextColor="{StaticResource BrandGold}" />
          </Grid>
          <ProgressBar Progress="{Binding ProgressValue}"
                       ProgressColor="{StaticResource BrandGold}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource ProgressBarTrack}, Dark={StaticResource DarkSurface}}"
                       HeightRequest="4" />
        </VerticalStackLayout>

        <!-- COUNTER CARDS — built dynamically in code-behind via BuildCounterCards() -->
        <VerticalStackLayout x:Name="CountersContainer"
                             Spacing="12"
                             Margin="0,16,0,0" />

        <!-- ADD COUNTER — small gold button + label, left-aligned -->
        <HorizontalStackLayout Margin="0,16,0,4" Spacing="10">

          <Border WidthRequest="36"
                  HeightRequest="36"
                  StrokeThickness="0"
                  BackgroundColor="{StaticResource BrandGold}"
                  VerticalOptions="Center">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnAddCounterTapped" />
            </Border.GestureRecognizers>
            <Label Text="+"
                     Style="{StaticResource FontBold}"
                     FontSize="20"
                     TextColor="White"
                     HorizontalOptions="Center"
                     VerticalOptions="Center" />
          </Border>

          <Label Text="Add Counter"
                 Style="{StaticResource FontSemiBold}"
                 FontSize="14"
                 VerticalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                             Dark={StaticResource DarkTextPrimary}}">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnAddCounterTapped" />
            </Label.GestureRecognizers>
          </Label>

        </HorizontalStackLayout>

        <!-- ROW NOTES CARD -->
        <Border Padding="16"
                Margin="0,16,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground},
                                                  Dark={StaticResource DarkCardBackground}}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="12">
            <HorizontalStackLayout Spacing="8">
              <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                <Image.Source>
                  <AppThemeBinding Light="notes_light.svg" Dark="notes_dark.svg" />
                </Image.Source>
              </Image>
              <Label Text="Row Notes"
                     Style="{StaticResource FontSemiBold}"
                     FontSize="14"
                     VerticalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                                 Dark={StaticResource DarkTextPrimary}}" />
            </HorizontalStackLayout>

            <!-- Quick-add: [row number] [note text] [+] -->
            <Grid ColumnDefinitions="70,*,44" ColumnSpacing="8">
              <Border Grid.Column="0"
                      StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkInputBackground}}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="RowNoteRowEntry"
                       Keyboard="Numeric"
                       Placeholder="Row"
                       Style="{StaticResource FontRegular}"
                       FontSize="13"
                       MaxLength="5"
                       HorizontalTextAlignment="Center"
                       Margin="4,0"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
              </Border>
              <Border Grid.Column="1"
                      StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkInputBackground}}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="RowNoteTextEntry"
                       Placeholder="e.g. decrease here"
                       Style="{StaticResource FontRegular}"
                       FontSize="13"
                       MaxLength="80"
                       Margin="10,0"
                       Completed="OnAddRowNoteTapped"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
              </Border>
              <Border Grid.Column="2"
                      StrokeThickness="0"
                      BackgroundColor="{StaticResource BrandGold}"
                      WidthRequest="44"
                      HeightRequest="44">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnAddRowNoteTapped" />
                </Border.GestureRecognizers>
                <Label Text="+"
                       Style="{StaticResource FontBold}"
                       FontSize="22"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
              </Border>
            </Grid>

            <VerticalStackLayout x:Name="RowNotesContainer"
                                 Spacing="8"
                                 IsVisible="{Binding HasRowNotes}" />
          </VerticalStackLayout>
        </Border>

        <!-- NOTES CARD -->
        <Border Padding="16"
                Margin="0,16,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                IsVisible="{Binding HasNotes}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <HorizontalStackLayout Spacing="8">
              <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                <Image.Source>
                  <AppThemeBinding Light="notes_light.svg" Dark="notes_dark.svg" />
                </Image.Source>
              </Image>
              <Label Text="Notes"
                     Style="{StaticResource FontSemiBold}"
                     FontSize="14"
                     VerticalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            </HorizontalStackLayout>
            <Label Text="{Binding Notes}"
                   Style="{StaticResource FontRegular}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   MaxLines="{Binding NotesMaxLines}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
            <Label Text="{Binding NotesToggleText}"
                   Style="{StaticResource FontMedium}"
                   FontSize="14"
                   TextColor="{StaticResource BrandGold}"
                   IsVisible="{Binding NotesCanExpand}">
              <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleNotesCommand}" />
              </Label.GestureRecognizers>
            </Label>
          </VerticalStackLayout>
        </Border>

        <!-- SAVE & GO BACK -->
        <Button Text="SAVE &amp; GO BACK"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding EndSessionCommand}" />

      </VerticalStackLayout>
    </ScrollView>

  </Grid>

</ContentPage>
