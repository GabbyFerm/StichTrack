<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:StitchTrack.Application.ViewModels;assembly=StitchTrack.Application"
             x:Class="StitchTrack.MAUI.Views.QuickCounterPage"
             x:DataType="viewModels:QuickCounterViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
             Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

    <!-- TOP BAR: Logo -->
    <Grid Grid.Row="0"
      BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
      Padding="30,30">
      <Image Source="logo.svg"
         HeightRequest="35"
         HorizontalOptions="Start"
         Aspect="AspectFit" />
    </Grid>

    <!-- PAGE TITLE -->
    <Grid Grid.Row="1"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
          HeightRequest="60"
          Padding="20,15">
      <Label Text="QUICK ROW COUNTER"
             Style="{StaticResource HeaderTitle}" />
    </Grid>

    <!-- MAIN CONTENT -->
    <ScrollView Grid.Row="2">
      <VerticalStackLayout Spacing="0" Padding="16">

        <!-- COUNTER CARD — number + all counter controls -->
        <Border Padding="20"
                Margin="0,16,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
          </Border.StrokeShape>

          <VerticalStackLayout Spacing="16">

            <!-- Row count label -->
            <Label Text="Current Row"
                   FontFamily="MontserratMedium"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center" />

            <!-- Counter number — larger than before -->
            <Label Text="{Binding CurrentCount}"
                   Style="{StaticResource CounterLabel}"
                   HorizontalOptions="Center" />

            <!-- +/- buttons -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Margin="0,8,0,0">

              <!-- Decrease -->
              <Border Grid.Column="0"
                      BackgroundColor="{StaticResource ButtonDecrease}"
                      HeightRequest="60"
                      StrokeThickness="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding DecrementCommand}" />
                </Border.GestureRecognizers>
                <Image Source="minus.svg"
                       HeightRequest="28"
                       WidthRequest="28"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                  <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                  </Image.Behaviors>
                </Image>
              </Border>

              <!-- Increase -->
              <Border Grid.Column="1"
                      BackgroundColor="{StaticResource ButtonIncrease}"
                      HeightRequest="60"
                      StrokeThickness="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding IncrementCommand}" />
                </Border.GestureRecognizers>
                <Image Source="plus.svg"
                       HeightRequest="28"
                       WidthRequest="28"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                  <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                  </Image.Behaviors>
                </Image>
              </Border>

            </Grid>

            <!-- Undo & Reset -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

              <!-- Undo -->
              <Border Grid.Column="0"
                      BackgroundColor="Transparent"
                      HorizontalOptions="Center">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding UndoCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Padding="10,8">
                  <Image Grid.Column="0"
                         WidthRequest="16"
                         HeightRequest="16"
                         VerticalOptions="Center">
                    <Image.Source>
                      <AppThemeBinding Light="undo_light.svg" Dark="undo_dark.svg" />
                    </Image.Source>
                  </Image>
                  <Label Text="Undo"
                         TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark=White}"
                         FontFamily="MontserratMedium"
                         FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

              <!-- Reset -->
              <Border Grid.Column="1"
                      BackgroundColor="Transparent"
                      HorizontalOptions="Center">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding ResetCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Padding="10,8">
                  <Image Grid.Column="0"
                         WidthRequest="16"
                         HeightRequest="16"
                         VerticalOptions="Center">
                    <Image.Source>
                      <AppThemeBinding Light="reset_light.svg" Dark="reset_dark.svg" />
                    </Image.Source>
                  </Image>
                  <Label Text="Reset"
                         TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark=White}"
                         FontFamily="MontserratMedium"
                         FontSize="13"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

            </Grid>

          </VerticalStackLayout>

        </Border>

        <!-- SAVE TO PROJECT — full width, below card -->
        <Border BackgroundColor="{StaticResource BrandGold}"
                HeightRequest="52"
                StrokeThickness="0"
                Margin="0,16,0,20">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
          </Border.StrokeShape>
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SaveToProjectCommand}" />
          </Border.GestureRecognizers>

          <HorizontalStackLayout Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
            <Image Source="disk.svg"
                   HeightRequest="20"
                   WidthRequest="20"
                   VerticalOptions="Center">
              <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="White" />
              </Image.Behaviors>
            </Image>
            <Label Text="SAVE TO PROJECT"
                   TextColor="White"
                   FontFamily="MontserratBold"
                   FontSize="14"
                   VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>

        <!-- Explanatory text below Save to Project -->
        <Label Text="Quick Counter is a one-off digital counter — like a manual click counter. Save to Project creates a new project with your current count."
               FontFamily="MontserratRegular"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
               HorizontalOptions="Start"
               HorizontalTextAlignment="Start"
               Opacity="0.8"
               Margin="10,4,10,0" />

      </VerticalStackLayout>
    </ScrollView>

  </Grid>

</ContentPage>
