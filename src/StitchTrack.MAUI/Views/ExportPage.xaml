<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:StitchTrack.Application.ViewModels;assembly=StitchTrack.Application"
             x:Class="StitchTrack.MAUI.Views.ExportPage"
             x:DataType="viewModels:ExportViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
             Shell.NavBarIsVisible="False">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- TOP BAR: Logo -->
    <Grid Grid.Row="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
          Padding="30,30,30,30">
      <Image Source="logo.svg"
             HeightRequest="35"
             HorizontalOptions="Start"
             Aspect="AspectFit" />
    </Grid>

    <!-- HEADER: Icon + Title -->
    <Grid Grid.Row="1"
      BackgroundColor="{AppThemeBinding Light={StaticResource LightAppBackground}, Dark={StaticResource DarkAppBackground}}"
      Padding="30,10,20,20">

      <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
        <Image Source="export.svg"
           WidthRequest="22"
           HeightRequest="22"
           VerticalOptions="Center">
          <Image.Behaviors>
            <toolkit:IconTintColorBehavior TintColor="White" />
          </Image.Behaviors>
        </Image>
        <Label Text="EXPORT"
           Style="{StaticResource HeaderTitle}"
           VerticalOptions="Center" />
      </HorizontalStackLayout>

    </Grid>

    <!-- CONTENT -->
    <ScrollView Grid.Row="2">
      <VerticalStackLayout Spacing="0" Padding="20,24,20,32">

        <!-- Export Options -->
        <Label Text="Export Options"
               Style="{StaticResource FontBold}"
               FontSize="16"
               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
               Margin="0,0,0,16" />

        <!-- Include archived checkbox -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,24">
          <CheckBox Grid.Column="0"
                    IsChecked="{Binding IncludeArchived}"
                    Color="{StaticResource BrandGold}"
                    VerticalOptions="Center" />
          <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
            <Label Text="Include archived projects"
                   Style="{StaticResource FontMedium}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            <Label Text="Archived projects are excluded by default"
                   Style="{StaticResource FontRegular}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   Opacity="0.6" />
          </VerticalStackLayout>
        </Grid>

        <!-- Divider -->
        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandGold}"
                 Opacity="0.3" Margin="0,0,0,24" />

        <!-- Export Data -->
        <Label Text="Export Data"
               Style="{StaticResource FontBold}"
               FontSize="16"
               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
               Margin="0,0,0,8" />

        <Label Text="Export your projects to a file you can save or share. JSON includes full project data, counters and session history. CSV is a simple spreadsheet format."
               Style="{StaticResource FontRegular}"
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                           Dark={StaticResource DarkTextSecondary}}"
               LineBreakMode="WordWrap"
               Opacity="0.8"
               Margin="0,0,0,16" />

        <!-- JSON Export row -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,20">

          <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                 VerticalOptions="Start" Margin="0,2,0,0">
            <Image.Source>
              <AppThemeBinding Light="json_light.svg" Dark="json_dark.svg" />
            </Image.Source>
          </Image>

          <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label Text="Export All Projects (JSON)"
                   Style="{StaticResource FontMedium}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            <Label Text="Includes projects and session history"
                   Style="{StaticResource FontRegular}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   Opacity="0.6" />
          </VerticalStackLayout>

          <Border Grid.Column="2"
                  StrokeThickness="1"
                  Stroke="{StaticResource BrandGold}"
                  BackgroundColor="Transparent"
                  Padding="12,8"
                  VerticalOptions="Center"
                  IsEnabled="{Binding IsNotExporting}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ExportJsonCommand}" />
            </Border.GestureRecognizers>
            <Label Text="EXPORT"
                   Style="{StaticResource FontSemiBold}"
                   FontSize="12"
                   TextColor="{StaticResource BrandGold}" />
          </Border>

        </Grid>

        <!-- CSV Export row -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,8">

          <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                 VerticalOptions="Start" Margin="0,2,0,0">
            <Image.Source>
              <AppThemeBinding Light="csv_light.svg" Dark="csv_dark.svg" />
            </Image.Source>
          </Image>

          <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label Text="Export All Projects (CSV)"
                   Style="{StaticResource FontMedium}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
            <Label Text="Columns: Name, CurrentCount, TotalRows, Notes, CreatedAt, IsArchived"
                   Style="{StaticResource FontRegular}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   Opacity="0.6" />
          </VerticalStackLayout>

          <Border Grid.Column="2"
                  StrokeThickness="1"
                  Stroke="{StaticResource BrandGold}"
                  BackgroundColor="Transparent"
                  Padding="12,8"
                  VerticalOptions="Center"
                  IsEnabled="{Binding IsNotExporting}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
            </Border.GestureRecognizers>
            <Label Text="EXPORT"
                   Style="{StaticResource FontSemiBold}"
                   FontSize="12"
                   TextColor="{StaticResource BrandGold}" />
          </Border>

        </Grid>

        <!-- Loading indicator while exporting -->
        <ActivityIndicator IsRunning="{Binding IsExporting}"
                           IsVisible="{Binding IsExporting}"
                           Color="{StaticResource BrandGold}"
                           HorizontalOptions="Center"
                           Margin="0,16,0,0" />

        <!-- Divider -->
        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BrandGold}"
         Opacity="0.3" Margin="0,24,0,24" />

        <!-- Import Data -->
        <Label Text="Import Data"
               Style="{StaticResource FontBold}"
               FontSize="16"
               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                           Dark={StaticResource DarkTextPrimary}}"
               Margin="0,0,0,8" />

        <Label Text="Import a previously exported JSON file. Always creates new projects — your existing data is never overwritten."
               Style="{StaticResource FontRegular}"
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                           Dark={StaticResource DarkTextSecondary}}"
               LineBreakMode="WordWrap"
               Opacity="0.8"
               Margin="0,0,0,16" />

        <!-- JSON Import row -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,8">

          <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                 VerticalOptions="Start" Margin="0,2,0,0">
            <Image.Source>
              <AppThemeBinding Light="json_light.svg" Dark="json_dark.svg" />
            </Image.Source>
          </Image>

          <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label Text="Import Projects (JSON)"
                   Style="{StaticResource FontMedium}"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                               Dark={StaticResource DarkTextPrimary}}" />
            <Label Text="Restores projects, counters and session history"
                   Style="{StaticResource FontRegular}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                               Dark={StaticResource DarkTextSecondary}}"
                   Opacity="0.6" />
          </VerticalStackLayout>

          <Border Grid.Column="2"
                  StrokeThickness="1"
                  Stroke="{StaticResource BrandGold}"
                  BackgroundColor="Transparent"
                  Padding="12,8"
                  VerticalOptions="Center"
                  IsEnabled="{Binding IsNotImporting}">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ImportJsonCommand}" />
            </Border.GestureRecognizers>
            <Label Text="IMPORT"
                   Style="{StaticResource FontSemiBold}"
                   FontSize="12"
                   TextColor="{StaticResource BrandGold}" />
          </Border>

        </Grid>

        <!-- Loading indicator while importing -->
        <ActivityIndicator IsRunning="{Binding IsImporting}"
                   IsVisible="{Binding IsImporting}"
                   Color="{StaticResource BrandGold}"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0" />

      </VerticalStackLayout>
    </ScrollView>

  </Grid>

</ContentPage>
