<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="StitchTrack.MAUI.Controls.ProjectFormPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False"
               HorizontalOptions="Fill"
               VerticalOptions="End">

  <Grid>

    <BoxView BackgroundColor="#80000000" />

    <!-- Card sits at the bottom with rounded top corners -->
    <Border Margin="0"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
            VerticalOptions="End">

      <Border.StrokeShape>
        <RoundRectangle CornerRadius="20,20,0,0" />
      </Border.StrokeShape>

      <Grid RowDefinitions="Auto,*,Auto"
            MaximumHeightRequest="720">

        <!-- ============================================ -->
        <!-- HEADER: Title + Close Button                 -->
        <!-- ============================================ -->
        <Grid Grid.Row="0"
              Padding="24,20,16,16"
              ColumnDefinitions="*,Auto">

          <Label x:Name="FormTitleLabel"
                 Grid.Column="0"
                 FontFamily="MontserratBold"
                 FontSize="20"
                 VerticalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

          <ImageButton Grid.Column="1"
                       Source="close.svg"
                       WidthRequest="32"
                       HeightRequest="32"
                       CornerRadius="16"
                       BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}"
                       Padding="6"
                       Clicked="OnCancelClicked">
            <ImageButton.Behaviors>
              <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource LightIconColor}, Dark={StaticResource DarkIconColor}}" />
            </ImageButton.Behaviors>
          </ImageButton>

        </Grid>

        <!-- ============================================ -->
        <!-- FORM FIELDS (scrollable)                     -->
        <!-- ============================================ -->
        <ScrollView Grid.Row="1">

          <VerticalStackLayout Padding="24,0,24,16" Spacing="20">

            <!-- PROJECT NAME (required) -->
            <VerticalStackLayout Spacing="8">

              <HorizontalStackLayout Spacing="4">
                <Label Text="Project Name"
                       FontFamily="MontserratSemiBold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                <Label Text="*"
                       FontFamily="MontserratSemiBold"
                       FontSize="14"
                       TextColor="{StaticResource BrandGold}" />
              </HorizontalStackLayout>

              <!-- Golden border matching Figma -->
              <Border StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark=#1F2937}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Entry x:Name="NameEntry"
                       Keyboard="Text"
                       Placeholder="My Knitting Project"
                       FontFamily="MontserratRegular"
                       FontSize="14"
                       MaxLength="200"
                       Margin="12,0"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
              </Border>

            </VerticalStackLayout>

            <!-- ── Cover Photo ─────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="6">

              <Label Text="Cover Photo"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                       Dark={StaticResource DarkTextPrimary}}" />

              <Label Text="Shown as the project thumbnail"
                     FontFamily="MontserratRegular"
                     FontSize="12"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                       Dark={StaticResource DarkTextSecondary}}" />

              <Border StrokeThickness="0"
                      BackgroundColor="{AppThemeBinding Light={StaticResource ButtonSecondary}, Dark={StaticResource ButtonSecondaryDark}}"
                      Padding="12,10">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnPhotoUploadTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                  <Image Source="camera.svg"
                         WidthRequest="16"
                         HeightRequest="16"
                         VerticalOptions="Center">
                    <Image.Behaviors>
                      <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                  </Image>
                  <Label x:Name="PhotoLabel"
                         Text="Add Cover Photo"
                         FontFamily="MontserratMedium"
                         FontSize="12"
                         TextColor="White"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

              <!-- Shown below the button once a photo is selected -->
              <Label x:Name="PhotoFileNameLabel"
                     FontFamily="MontserratRegular"
                     FontSize="11"
                     TextColor="{StaticResource BrandGold}"
                     IsVisible="False" />

            </VerticalStackLayout>

            <!-- ── Pattern Files ──────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="6">

              <Label Text="Pattern Files"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                       Dark={StaticResource DarkTextPrimary}}" />

              <Label Text="PDF or photo of your pattern"
                     FontFamily="MontserratRegular"
                     FontSize="12"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                       Dark={StaticResource DarkTextSecondary}}" />

              <Border StrokeThickness="0"
                      BackgroundColor="{AppThemeBinding Light=#424B54, Dark=#5E6B76}"
                      Padding="12,10">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnAddPatternFileTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                  <Image Source="file.svg"
                         WidthRequest="16" HeightRequest="16"
                         VerticalOptions="Center">
                    <Image.Behaviors>
                      <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                  </Image>
                  <Label Text="Add Pattern"
                         FontFamily="MontserratMedium"
                         FontSize="12"
                         TextColor="White"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

              <!-- 2-column chip grid built in code-behind -->
              <VerticalStackLayout x:Name="PatternFilesContainer" Spacing="8" />

            </VerticalStackLayout>

            <!-- ── Inspiration Photos ─────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="6">

              <Label Text="Inspiration Photos"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary},
                                       Dark={StaticResource DarkTextPrimary}}" />

              <Label Text="Photos for inspiration or reference"
                     FontFamily="MontserratRegular"
                     FontSize="12"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary},
                                       Dark={StaticResource DarkTextSecondary}}" />

              <Border StrokeThickness="0"
                      BackgroundColor="{AppThemeBinding Light=#424B54, Dark=#5E6B76}"
                      Padding="12,10">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnAddInspirationPhotoTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                  <Image Source="camera.svg"
                         WidthRequest="16" HeightRequest="16"
                         VerticalOptions="Center">
                    <Image.Behaviors>
                      <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                  </Image>
                  <Label Text="Add Photo"
                         FontFamily="MontserratMedium"
                         FontSize="12"
                         TextColor="White"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </Border>

              <!-- 2-column chip grid built in code-behind -->
              <VerticalStackLayout x:Name="InspirationPhotosContainer" Spacing="8" />

            </VerticalStackLayout>

            <!-- COLOUR TAG -->
            <VerticalStackLayout Spacing="10">

              <Label Text="Colour Tag"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

              <HorizontalStackLayout x:Name="ColorPickerContainer"
                                      Spacing="9" />

            </VerticalStackLayout>

            <!-- Tags section -->
            <VerticalStackLayout Spacing="8">

              <Label Text="Tags"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

              <!-- Input row: Entry + Add button side by side -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource BrandGold}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark=#1F2937}"
                        Padding="0">
                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                  </Border.StrokeShape>
                  <Entry x:Name="TagEntry"
                         Keyboard="Text"
                         Placeholder="e.g. Knitting, Amigurumi..."
                         FontFamily="MontserratRegular"
                         FontSize="14"
                         MaxLength="40"
                         Margin="12,0"
                         ReturnCommand="{x:Null}"
                         TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                         PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                         Completed="OnTagEntryCompleted" />
                </Border>

                <!-- Small Add button — same height as the Entry border -->
                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource BrandGold}"
                        WidthRequest="44"
                        HeightRequest="44">
                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                  </Border.StrokeShape>
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTagTapped" />
                  </Border.GestureRecognizers>
                  <Label Text="+"
                         FontFamily="MontserratBold"
                         FontSize="22"
                         TextColor="White"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />
                </Border>

              </Grid>

              <!-- Chips are built in code-behind and added here -->
              <FlexLayout x:Name="TagChipContainer"
                          Wrap="Wrap"
                          Direction="Row"
                          JustifyContent="Start"
                          AlignItems="Center"/>

            </VerticalStackLayout>

            <!-- Needle / Hook Size section -->
            <VerticalStackLayout Spacing="8">

              <Label Text="Needle / Hook Size"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

              <Border StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark=#1F2937}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="NeedleSizeEntry"
                       Keyboard="Text"
                       Placeholder="e.g. 5.0mm, US 8, 4.5mm / G-6"
                       FontFamily="MontserratRegular"
                       FontSize="14"
                       MaxLength="50"
                       Margin="12,0"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
              </Border>

            </VerticalStackLayout>

            <!-- TOTAL ROWS (optional) -->
            <VerticalStackLayout Spacing="8">

              <Label Text="Total rows"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

              <Border StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark=#1F2937}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Entry x:Name="TotalRowsEntry"
                       Placeholder="Optional"
                       Keyboard="Numeric"
                       FontFamily="MontserratRegular"
                       FontSize="14"
                       MaxLength="6"
                       Margin="12,0"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
              </Border>

            </VerticalStackLayout>

            <!-- NOTES (optional) -->
            <VerticalStackLayout Spacing="8">

              <Label Text="Notes"
                     FontFamily="MontserratSemiBold"
                     FontSize="14"
                     TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />

              <Border StrokeThickness="1"
                      Stroke="{StaticResource BrandGold}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark=#1F2937}"
                      Padding="0">
                <Border.StrokeShape>
                  <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <ScrollView HeightRequest="160"
                            Orientation="Vertical">
                  <Editor x:Name="NotesEditor"
                          Keyboard="Text"
                          Placeholder="Optional notes about this project..."
                          FontFamily="MontserratRegular"
                          FontSize="14"
                          Margin="12,8"
                          AutoSize="TextChanges"
                          VerticalTextAlignment="Start"
                          TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                          PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                </ScrollView>

              </Border>

            </VerticalStackLayout>

          </VerticalStackLayout>

        </ScrollView>

        <!-- ============================================ -->
        <!-- FOOTER: Cancel + Save Buttons                -->
        <!-- ============================================ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="24,16,24,40">

          <!-- Cancel Button -->
          <Border Grid.Column="0"
                  StrokeThickness="0"
                  BackgroundColor="{StaticResource ButtonCancel}"
                  HeightRequest="50">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnCancelClicked" />
            </Border.GestureRecognizers>

            <Label Text="CANCEL"
                   FontFamily="MontserratSemiBold"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White" />
          </Border>

          <!-- Save / Create Button -->
          <Border Grid.Column="1"
                  StrokeThickness="0"
                  BackgroundColor="{StaticResource BrandGold}"
                  HeightRequest="50">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnSaveClicked" />
            </Border.GestureRecognizers>

            <Label x:Name="SaveButtonLabel"
                   FontFamily="MontserratSemiBold"
                   FontSize="14"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White" />
          </Border>

        </Grid>

      </Grid>

    </Border>

  </Grid>

</toolkit:Popup>
